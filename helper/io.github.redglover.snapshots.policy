<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>omarchy-snapshots</vendor>
  <vendor_url>https://github.com/redglover/omarchy-snapshots</vendor_url>

  <action id="io.github.redglover.snapshots.read">
    <description>List snapshots and the paths they changed</description>
    <message>Reading snapshot metadata requires authentication</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/omarchy-snapshots/snapshots-read</annotate>
  </action>

  <action id="io.github.redglover.snapshots.admin">
    <description>Show file diffs, restore files, and manage snapshots</description>
    <message>Authentication is required to change snapshots or read file contents from them</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/omarchy-snapshots/snapshots-admin</annotate>
  </action>
</policyconfig>
